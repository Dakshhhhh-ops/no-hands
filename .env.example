# Copy to .env.local and fill in a key. Read only by the server, never sent to the browser.
# Claude is the default whenever its key is set: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional Groq fallback (free tier), used when no Claude key is set: https://console.groq.com/keys
GROQ_API_KEY=

# Seals the Wispr Flow sign-in into an encrypted, HttpOnly cookie (AES-256-GCM) so it survives
# restarts. Any random string of 32 or more characters; keep it stable, because changing it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Left empty, each server process uses a random key and sign-ins end when it restarts.
WISPR_SESSION_SECRET=

# Optional overrides
# VOICEARCHITECT_PROVIDER=groq            # force groq, anthropic, or offline
# VOICEARCHITECT_MODEL=claude-opus-5-5    # or claude-sonnet-5-5, claude-haiku-5-5
# VOICEARCHITECT_EFFORT=medium
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=medium
# GROQ_TEMPERATURE=0.5
# GROQ_SEED=7

# Recorded answers: save each successful live answer to server/recordings/ (commit them for the demo)
# VOICEARCHITECT_RECORD=1
# VOICEARCHITECT_RECORDINGS_DIR=server/recordings

# Behind a reverse proxy (Render, Fly.io, Railway), so limits and the Wispr sign-in see the real client
# VOICEARCHITECT_TRUST_PROXY=1
