# Copy to .env.local and fill in ONE key. Read only by the server, never sent to the browser.
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Or Anthropic:
ANTHROPIC_API_KEY=

# Optional overrides
# VOICEARCHITECT_PROVIDER=groq            # or anthropic, when both keys are set
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=medium
# VOICEARCHITECT_MODEL=claude-opus-5-5
# VOICEARCHITECT_EFFORT=medium
