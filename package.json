{
  "name": "voicearchitect",
  "private": true,
  "version": "0.1.0",
  "description": "Voice keeps your architecture diagram in sync with your code: import docker-compose, describe a change in plain language, review the exact diff, then check the diagram against newer code.",
  "keywords": [
    "wispr-flow",
    "voice",
    "dictation",
    "architecture",
    "docker-compose",
    "drift-detection",
    "openapi",
    "react",
    "typescript",
    "zod"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env.local server/serve.ts",
    "test": "node --experimental-vm-modules --test --require ./tests/setup.js",
    "test:vitest": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@types/dagre": "^0.7.54",
    "@vitejs/plugin-react": "^6.1.2",
    "dagre": "^0.8.5",
    "fflate": "^0.8.3",
    "lenis": "1.3.26",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
